// ============================================================
// Rule ID     : LM-002
// Name        : Service Principal Credential Added
// MITRE Tactic: Lateral Movement / Persistence
// MITRE Tech  : T1098.001 — Account Manipulation: Additional Cloud Credentials
// Data Source : AuditLogs (Entra ID)
// Severity    : HIGH
// Author      : Neel Kotnis
// ============================================================
//
// Description:
//   Detects when a new client secret or certificate credential is
//   added to a service principal or app registration. Attackers
//   who compromise an admin account will add credentials to
//   high-privileged service principals as a persistence mechanism,
//   allowing them to authenticate even after the initial compromise
//   is discovered and the user's password is reset.
//
// False Positives:
//   - Legitimate credential rotation by platform engineering
//   - CI/CD pipeline creating new app credentials for deployments
//   - IaC (Terraform) managing app registrations
//
// Tuning Notes:
//   - High-priority: SPs with Owner or Contributor roles (cross-ref AZ-006)
//   - AddedBy field: flag additions made by users rather than automation
//   - CredentialType: "Password" = client secret, "AsymmetricX509Cert" = cert
//   - Correlate with LM-001 — if a new credential was added AND a new IP
//     appeared for that SP shortly after, confidence is very high
// ============================================================

AuditLogs
| where TimeGenerated >= ago(1d)
| where OperationName in (
    "Add service principal credentials",
    "Update application – Certificates and secrets management"
  )
| where Result == "success"
| extend
    SPName            = tostring(TargetResources[0].displayName),
    SPId              = tostring(TargetResources[0].id),
    AddedBy           = tostring(InitiatedBy.user.userPrincipalName),
    AddedByApp        = tostring(InitiatedBy.app.displayName),
    ModifiedProperties = tostring(TargetResources[0].modifiedProperties)
| extend
    CredentialType    = extract('"displayName":"([^"]+)"', 1, ModifiedProperties)
| project
    TimeGenerated,
    SPName,
    SPId,
    CredentialType,
    AddedBy,
    AddedByApp,
    Result,
    CorrelationId
| order by TimeGenerated desc
