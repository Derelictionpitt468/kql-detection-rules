// ============================================================
// Rule ID     : CA-002
// Name        : Password Spray Detection
// MITRE Tactic: Credential Access
// MITRE Tech  : T1110.003 — Brute Force: Password Spraying
// Data Source : SigninLogs (Entra ID)
// Severity    : HIGH
// Author      : Neel Kotnis
// ============================================================
//
// Description:
//   Detects password spray attacks — a single IP attempting to
//   authenticate against many distinct accounts using a small
//   number of common passwords. Unlike brute force (many attempts
//   against one account), spraying hits many accounts lightly
//   to avoid lockout thresholds.
//
// False Positives:
//   - Shared NAT/proxy IPs used by many users simultaneously
//   - Corporate VPN exit nodes
//   - Misconfigured SSO or identity proxy generating repeated failures
//
// Tuning Notes:
//   - The key signal is HIGH distinct account count from ONE IP
//   - Adjust DistinctAccountThreshold based on your environment
//   - Exclude known shared egress IPs (VPN, proxy)
//   - Correlate with CA-001 — if same IP appears in both, high confidence
// ============================================================

let DistinctAccountThreshold = 10;
let TimeWindow = 30m;

SigninLogs
| where TimeGenerated >= ago(1h)
| where ResultType != "0"
| where ResultType in ("50126", "50053", "50055", "50074")
| summarize
    DistinctAccounts  = dcount(UserPrincipalName),
    AccountList       = make_set(UserPrincipalName, 20),
    FailureCount      = count(),
    FirstAttempt      = min(TimeGenerated),
    LastAttempt       = max(TimeGenerated),
    AppList           = make_set(AppDisplayName, 5),
    LocationList      = make_set(Location, 5)
    by IPAddress, bin(TimeGenerated, TimeWindow)
| where DistinctAccounts >= DistinctAccountThreshold
| project
    TimeWindow        = TimeGenerated,
    IPAddress,
    DistinctAccounts,
    FailureCount,
    AccountList,
    AppList,
    LocationList,
    FirstAttempt,
    LastAttempt
| order by DistinctAccounts desc
