// ============================================================
// Rule ID     : PS-005
// Name        : Federated Identity Credential Added to Service Principal
// MITRE Tactic: Persistence
// MITRE Tech  : T1098.001 — Account Manipulation: Additional Cloud Credentials
// Data Source : AuditLogs (Entra ID)
// Severity    : HIGH
// Author      : Neel Kotnis
// ============================================================
//
// Description:
//   Detects when a federated identity credential is added to a
//   service principal or app registration. Federated credentials
//   allow external identity providers (GitHub Actions, GitLab,
//   Kubernetes) to obtain Azure tokens without a client secret.
//   Attackers can abuse this to create a persistent authentication
//   path from an external system they control — surviving even
//   if all client secrets are rotated.
//
// False Positives:
//   - Legitimate Workload Identity Federation setup for GitHub
//     Actions, Azure Pipelines, or GKE
//   - DevOps teams configuring CI/CD pipelines
//
// Tuning Notes:
//   - IssuerURL: flag issuers that are not on your approved list
//     (e.g., unknown GitHub orgs, external Kubernetes clusters)
//   - Correlate with PE-001 — federated credential added to an
//     SP that also has Owner role is critical severity
// ============================================================

AuditLogs
| where TimeGenerated >= ago(1d)
| where OperationName contains "federated"
       or OperationName == "Add federated identity credential"
| where Result == "success"
| extend
    SPName            = tostring(TargetResources[0].displayName),
    SPId              = tostring(TargetResources[0].id),
    AddedBy           = tostring(InitiatedBy.user.userPrincipalName),
    AddedByApp        = tostring(InitiatedBy.app.displayName),
    CredDetails       = tostring(TargetResources[0].modifiedProperties)
| extend
    IssuerURL         = extract('"issuer","newValue":"([^"]+)"', 1, CredDetails),
    Subject           = extract('"subject","newValue":"([^"]+)"', 1, CredDetails)
| project
    TimeGenerated,
    SPName,
    SPId,
    AddedBy,
    AddedByApp,
    IssuerURL,
    Subject,
    CorrelationId
| order by TimeGenerated desc
