// ============================================================
// Rule ID     : PS-002
// Name        : New Service Principal Created with Credentials
// MITRE Tactic: Persistence
// MITRE Tech  : T1136.003 — Create Account: Cloud Account
// Data Source : AuditLogs (Entra ID)
// Severity    : MEDIUM
// Author      : Neel Kotnis
// ============================================================
//
// Description:
//   Detects when a new service principal (app registration) is
//   created and immediately has credentials added to it. Attackers
//   with sufficient privileges will create new service principals
//   as a persistence mechanism, giving them a non-human identity
//   that can authenticate independently of any user account.
//
// False Positives:
//   - DevOps pipelines creating service principals for deployments
//   - IaC (Terraform, Bicep) provisioning app registrations
//   - Developer creating a new app for testing
//
// Tuning Notes:
//   - Focus on SPs created outside of business hours
//   - Flag SPs created and immediately assigned privileged RBAC roles
//   - CreatedBy field: SPs created by non-automation users are higher risk
// ============================================================

let NewSPs =
    AuditLogs
    | where TimeGenerated >= ago(1d)
    | where OperationName == "Add service principal"
    | where Result == "success"
    | extend
        SPName        = tostring(TargetResources[0].displayName),
        SPId          = tostring(TargetResources[0].id),
        CreatedBy     = tostring(InitiatedBy.user.userPrincipalName)
    | project TimeGenerated, SPName, SPId, CreatedBy;

let NewCredentials =
    AuditLogs
    | where TimeGenerated >= ago(1d)
    | where OperationName == "Add service principal credentials"
    | where Result == "success"
    | extend
        SPId          = tostring(TargetResources[0].id),
        AddedBy       = tostring(InitiatedBy.user.userPrincipalName)
    | project CredTime = TimeGenerated, SPId, AddedBy;

NewSPs
| join kind=inner NewCredentials on SPId
| where (CredTime - TimeGenerated) <= 10m    // credentials added within 10 min of SP creation
| project
    SPCreatedAt       = TimeGenerated,
    CredentialAddedAt = CredTime,
    SPName,
    SPId,
    CreatedBy,
    CredentialAddedBy = AddedBy
| order by SPCreatedAt desc
